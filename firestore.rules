rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'arizo4212@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Blueprints
    function isValidProduct(data) {
      return data.keys().hasAll([
        'sku', 'name', 'category', 'subType', 'price', 'stock',
        'description', 'volumeOrSize', 'imageUrl', 'featured', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'sku', 'name', 'category', 'subType', 'price', 'stock',
        'description', 'volumeOrSize', 'imageUrl', 'featured', 'updatedAt'
      ]) &&
      data.sku is string && data.sku.size() >= 2 && data.sku.size() <= 40 && data.sku.matches('^[A-Z0-9\\-]+$') &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
      data.category is string && data.category in ['Parfum & Lip Oil', 'Tas & Sepatu', 'Jam Tangan & Baju'] &&
      data.subType is string && data.subType in ['Perfume', 'Lip Oil', 'Tas', 'Sepatu', 'Jam Tangan', 'Baju'] &&
      data.price is number && data.price >= 0 && data.price <= 1000000000 &&
      data.stock is number && data.stock >= 0 && data.stock <= 100000 &&
      data.description is string && data.description.size() >= 10 && data.description.size() <= 600 &&
      data.volumeOrSize is string && data.volumeOrSize.size() >= 1 && data.volumeOrSize.size() <= 60 &&
      data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 500 &&
      data.featured is bool &&
      data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 40;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll([
        'uid', 'name', 'email', 'phone', 'address', 'city',
        'postalCode', 'totalOrders', 'totalSpent', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'name', 'email', 'phone', 'address', 'city',
        'postalCode', 'totalOrders', 'totalSpent', 'updatedAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
      data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30 &&
      data.address is string && data.address.size() >= 5 && data.address.size() <= 400 &&
      data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
      data.postalCode is string && data.postalCode.size() >= 3 && data.postalCode.size() <= 15 &&
      data.totalOrders is number && data.totalOrders >= 0 && data.totalOrders <= 100000 &&
      data.totalSpent is number && data.totalSpent >= 0 && data.totalSpent <= 100000000000 &&
      data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 40;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
        'orderNumber', 'customerUid', 'customerName', 'customerEmail', 'customerPhone',
        'shippingAddress', 'itemsSummary', 'itemCount', 'totalAmount', 'paymentMethod',
        'paymentAccountSender', 'paymentReferenceNumber', 'paymentProofImage',
        'paymentStatus', 'orderStatus', 'adminNotes', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'orderNumber', 'customerUid', 'customerName', 'customerEmail', 'customerPhone',
        'shippingAddress', 'itemsSummary', 'itemCount', 'totalAmount', 'paymentMethod',
        'paymentAccountSender', 'paymentReferenceNumber', 'paymentProofImage',
        'paymentStatus', 'orderStatus', 'adminNotes', 'createdAt', 'updatedAt'
      ]) &&
      data.orderNumber is string && data.orderNumber.size() >= 8 && data.orderNumber.size() <= 40 && data.orderNumber.matches('^YSL\\-[0-9]{4,10}$') &&
      data.customerUid is string && data.customerUid.size() >= 1 && data.customerUid.size() <= 128 &&
      data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
      data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 150 &&
      data.customerPhone is string && data.customerPhone.size() >= 5 && data.customerPhone.size() <= 30 &&
      data.shippingAddress is string && data.shippingAddress.size() >= 5 && data.shippingAddress.size() <= 500 &&
      data.itemsSummary is string && data.itemsSummary.size() >= 2 && data.itemsSummary.size() <= 1500 &&
      data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 1000 &&
      data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 10000000000 &&
      data.paymentMethod is string && data.paymentMethod in ['Bank Transfer BCA', 'Bank Transfer Mandiri', 'QRIS YSL Beaute'] &&
      data.paymentAccountSender is string && data.paymentAccountSender.size() >= 2 && data.paymentAccountSender.size() <= 120 &&
      data.paymentReferenceNumber is string && data.paymentReferenceNumber.size() >= 2 && data.paymentReferenceNumber.size() <= 80 &&
      data.paymentProofImage is string && data.paymentProofImage.size() >= 5 && data.paymentProofImage.size() <= 350000 &&
      data.paymentStatus is string && data.paymentStatus in ['waiting_approval', 'approved', 'rejected'] &&
      data.orderStatus is string && data.orderStatus in ['pending_verification', 'processing', 'shipped', 'completed', 'cancelled'] &&
      data.adminNotes is string && data.adminNotes.size() <= 400 &&
      data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 40 &&
      data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 40;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'updatedAt']) &&
      data.keys().hasOnly(['uid', 'email', 'role', 'updatedAt']) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
      data.role is string && data.role == 'admin' &&
      data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 40;
    }

    // 1. Products Collection (Public Catalog, Admin Management + Verified Customer Stock Decrement)
    match /products/{productId} {
      allow get: if isValidId(productId) && resource.data.price >= 0;
      allow list: if resource.data.price >= 0;
      allow create: if isVerifiedUser() && isValidId(productId) && isValidProduct(incoming()) && isAdmin();
      allow update: if isVerifiedUser() && isValidId(productId) && isValidProduct(incoming()) && (
        isAdmin() ||
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'updatedAt']) &&
          incoming().stock >= 0 &&
          incoming().stock < existing().stock &&
          incoming().sku == existing().sku &&
          incoming().price == existing().price
        )
      );
      allow delete: if isVerifiedUser() && isValidId(productId) && isAdmin();
    }

    // 2. Customers Collection (PII Isolated to Owner or Admin)
    match /customers/{customerId} {
      allow get: if isVerifiedUser() && isValidId(customerId) && (
        request.auth.uid == customerId || isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      allow create: if isVerifiedUser() && isValidId(customerId) && isValidCustomer(incoming()) && (
        (request.auth.uid == customerId && incoming().uid == request.auth.uid) || isAdmin()
      );
      allow update: if isVerifiedUser() && isValidId(customerId) && isValidCustomer(incoming()) && (
        isAdmin() ||
        (
          request.auth.uid == customerId &&
          incoming().uid == existing().uid &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'phone', 'address', 'city', 'postalCode', 'totalOrders', 'totalSpent', 'updatedAt'
          ])
        )
      );
      allow delete: if isVerifiedUser() && isValidId(customerId) && isAdmin();
    }

    // 3. Orders Collection (Isolated to Ordering Customer or Admin)
    match /orders/{orderId} {
      allow get: if isVerifiedUser() && isValidId(orderId) && (
        resource.data.customerUid == request.auth.uid || isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.customerUid == request.auth.uid || isAdmin()
      );
      allow create: if isVerifiedUser() && isValidId(orderId) && isValidOrder(incoming()) && (
        (
          incoming().customerUid == request.auth.uid &&
          incoming().paymentStatus == 'waiting_approval' &&
          incoming().orderStatus == 'pending_verification'
        ) || isAdmin()
      );
      allow update: if isVerifiedUser() && isValidId(orderId) && isValidOrder(incoming()) && (
        isAdmin() ||
        (
          existing().customerUid == request.auth.uid &&
          incoming().customerUid == existing().customerUid &&
          incoming().orderNumber == existing().orderNumber &&
          incoming().createdAt == existing().createdAt &&
          incoming().totalAmount == existing().totalAmount &&
          !(existing().orderStatus in ['completed', 'cancelled']) &&
          incoming().paymentStatus == 'waiting_approval' &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'paymentAccountSender', 'paymentReferenceNumber', 'paymentProofImage', 'paymentStatus', 'updatedAt'
          ])
        )
      );
      allow delete: if isVerifiedUser() && isValidId(orderId) && isAdmin();
    }

    // 4. Admins Collection
    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && (
        request.auth.uid == adminId || isAdmin()
      );
      allow list: if isVerifiedUser() && isAdmin();
      allow create, update: if isVerifiedUser() && isValidId(adminId) && isValidAdminUser(incoming()) && isAdmin();
      allow delete: if isVerifiedUser() && isValidId(adminId) && isAdmin();
    }
  }
}
